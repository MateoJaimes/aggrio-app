APP_NAME=Aggrio
APP_ENV=local
# Se genera con: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=aggrio
DB_USERNAME=postgres
DB_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Vacío: la API usa sólo tokens Bearer, no el modo SPA/cookie (RF006)
SANCTUM_STATEFUL_DOMAINS=

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aggrio
MINIO_USE_PATH_STYLE_ENDPOINT=true

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Superadmin inicial (SuperadminSeeder) ---
SUPERADMIN_NAME="Superadmin Aggrio"
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# --- Sesión y seguridad (RF003 / RF004 / RF005) ---
FRONTEND_URL=http://localhost:4200

# Minutos de vida de cada token de sesión
SANCTUM_ACCESS_TOKEN_TTL=60
SANCTUM_REFRESH_TOKEN_TTL=10080

# Doble factor: minutos de vida del reto de login y tolerancia TOTP (x30s)
TWO_FACTOR_CHALLENGE_TTL=5
TWO_FACTOR_WINDOW=1

# --- Ingesta IoT (RF002) ---
# false: se aceptan lecturas sin X-Device-Key (quedan en el log). Pasar a true
# sólo cuando todos los ESP32 envíen su key; antes de eso dejarían de guardar datos.
IOT_REQUIRE_DEVICE_KEY=false
# Lecturas por minuto aceptadas por API key (o por IP si el sensor no envía key)
IOT_RATE_LIMIT_PER_MINUTE=120
